+
+/* Canonical video-reference functionality additions */
+.mobile-brand span,
+.mobile-brand strong { display: block; line-height: 1; }
+.mobile-brand span { font-family: Georgia, serif; font-style: italic; color: var(--accent-2); font-size: 1rem; }
+.mobile-brand strong { margin-top: 3px; color: #fff; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: .46rem; letter-spacing: .17em; }
+
+.source-backdrop { z-index: 120; }
+.source-dialog {
+  width: min(620px, calc(100vw - 28px));
+  border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--line));
+  border-radius: 22px;
+  background: linear-gradient(145deg, rgba(18,14,23,.99), rgba(8,7,11,.99));
+  box-shadow: 0 32px 100px rgba(0,0,0,.72), 0 0 55px color-mix(in srgb, var(--accent-glow) 35%, transparent);
+  overflow: hidden;
+}
+.source-dialog > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 21px 23px;
+  border-bottom: 1px solid var(--line);
+}
+.source-dialog h2 { margin: 5px 0 0; font-size: 1.55rem; }
+.source-dialog > header > button {
+  width: 42px;
+  height: 42px;
+  border: 1px solid var(--line);
+  border-radius: 13px;
+  background: rgba(255,255,255,.035);
+  display: grid;
+  place-items: center;
+}
+.source-dialog > p { margin: 0; padding: 22px 23px 5px; color: var(--muted); line-height: 1.65; }
+.source-dialog form { display: grid; gap: 15px; padding: 18px 23px 24px; }
+.source-dialog label { display: grid; gap: 8px; color: #ddd7e3; font-size: .82rem; font-weight: 650; }
+.source-dialog input {
+  width: 100%;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: #101018;
+  color: #fff;
+  padding: 13px 14px;
+  outline: none;
+}
+.source-dialog input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
+.source-submit {
+  min-height: 46px;
+  border: 0;
+  border-radius: 12px;
+  background: linear-gradient(135deg, var(--accent), var(--accent-2));
+  color: #fff;
+  font-weight: 750;
+  box-shadow: 0 14px 35px color-mix(in srgb, var(--accent) 22%, transparent);
+}
+.source-submit:disabled { opacity: .55; cursor: wait; }
+.source-error { border: 1px solid rgba(255,86,110,.35); border-radius: 11px; background: rgba(112,20,36,.22); color: #ffb7c2; padding: 11px 13px; font-size: .78rem; line-height: 1.45; }
+
+.document-stage {
+  position: relative;
+  min-height: 0;
+  padding: 10px;
+  overflow: hidden;
+  background: #08080d;
+}
+.reader-document {
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: #fff;
+}
+.document-open-link {
+  position: absolute;
+  right: 22px;
+  bottom: 20px;
+  z-index: 4;
+  border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
+  border-radius: 999px;
+  background: rgba(8,7,12,.88);
+  color: var(--accent-2);
+  padding: 8px 12px;
+  text-decoration: none;
+  font-size: .72rem;
+  backdrop-filter: blur(16px);
+}
+.temporary-reader-line { height: 3px; border-radius: 99px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); opacity: .75; }
+
+@media (max-width: 720px) {
+  .mobile-brand { min-width: 62px; }
+  .mobile-brand span { font-size: .82rem; }
+  .mobile-brand strong { font-size: .38rem; }
+  .source-dialog { width: 100%; min-height: 100%; border: 0; border-radius: 0; }
+  .source-dialog > p { font-size: .84rem; }
+  .document-stage { padding: 0; }
+  .reader-document { border: 0; border-radius: 0; }
+  .document-open-link { right: 12px; bottom: 12px; }
+}
