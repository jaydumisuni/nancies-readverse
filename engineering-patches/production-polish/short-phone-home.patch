 }
+
+@media (max-width: 760px) {
+  /* A closed mobile chat must not leave hidden controls geometrically sitting
+     underneath the fixed six-tab navigation. */
+  .companion-panel:not(.open) { display: none !important; }
+  .companion-panel.open {
+    display: grid !important;
+    grid-template-rows: auto minmax(0, 1fr) auto !important;
+    overflow: hidden !important;
+  }
+  .companion-panel.open .companion-header {
+    position: relative;
+    z-index: 4;
+    flex: none;
+  }
+  .companion-panel.open .companion-header > button {
+    position: relative;
+    z-index: 5;
+    min-width: 44px;
+    min-height: 44px;
+    pointer-events: auto;
+  }
+  .companion-panel.open .chat-body {
+    min-height: 0 !important;
+    overflow-y: auto !important;
+  }
+  .companion-panel.open .chat-input {
+    position: relative;
+    z-index: 3;
+    flex: none;
+  }
+}
+
+@media (max-width: 760px) and (max-height: 700px) {
+  /* Short phones keep the approved layout and all actions; only spacing is
+     tightened so the fixed six-tab navigation never covers usable controls. */
+  .notverse-home .notverse-section > header > button {
+    display: none !important;
+  }
+
+  .search-view {
+    padding-top: 10px !important;
+  }
+
+  .search-view > header:not(.profile-cover) {
+    margin-bottom: 7px !important;
+  }
+
+  .search-view .notverse-eyebrow {
+    font-size: 9px;
+  }
+
+  .search-view h1 {
+    font-size: 30px !important;
+    margin: 2px 0 4px !important;
+  }
+
+  .search-view > header p {
+    font-size: 11px;
+    line-height: 1.25;
+    max-height: 2.5em;
+    overflow: hidden;
+  }
+
+  .notverse-search-box {
+    padding: 4px 5px 4px 10px;
+  }
+
+  .notverse-search-box input {
+    min-width: 0;
+    padding: 7px 6px;
+    font-size: 16px;
+  }
+
+  .notverse-search-box button {
+    padding: 9px 12px;
+  }
+
+  .search-action-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
+    gap: 6px !important;
+    margin: 9px 0 12px !important;
+  }
+
+  .search-action-grid button {
+    min-width: 0;
+    padding: 6px !important;
+    gap: 2px !important;
+  }
+
+  .search-action-grid button > span { font-size: 16px; }
+  .search-action-grid button strong {
+    font-size: 11px;
+    line-height: 1.1;
+  }
+  .search-action-grid button small {
+    display: block;
+    min-width: 0;
+    font-size: 8px;
+    line-height: 1.2;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .library-grid {
+    grid-template-columns: repeat(4, 128px) !important;
+    gap: 8px !important;
+    overflow-x: auto;
+    padding-bottom: 6px;
+  }
+
+  .library-grid > button {
+    min-width: 128px;
+    padding: 7px !important;
+  }
+
+  .inbox-view {
+    height: calc(100dvh - 62px);
+    min-height: 0 !important;
+    overflow: hidden;
+    display: grid;
+    grid-template-rows: auto minmax(0, 1fr);
+    padding-top: 8px !important;
+    padding-bottom: 74px !important;
+  }
+
+  .inbox-view > header {
+    margin-bottom: 6px !important;
+  }
+
+  .inbox-view h1 {
+    font-size: 30px !important;
+    margin: 2px 0 4px !important;
+  }
+
+  .inbox-view > header p {
+    font-size: 11px;
+    line-height: 1.25;
+  }
+
+  .inbox-layout {
+    min-height: 0 !important;
+    height: 100%;
+    grid-template-rows: 82px minmax(0, 1fr);
+    overflow: hidden;
+  }
+
+  .inbox-layout > aside {
+    max-height: 82px !important;
+    overflow-y: auto;
+  }
+
+  .inbox-layout > main {
+    min-height: 0;
+    grid-template-rows: auto minmax(0, 1fr) auto !important;
+    overflow: hidden;
+  }
+
+  .message-thread {
+    min-height: 0;
+    overflow-y: auto;
+    padding: 10px !important;
+  }
+
+  .inbox-layout main > form input {
+    min-width: 0;
+    font-size: 16px;
+  }
+}
