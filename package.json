{
  "name": "notverse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:guided": "node scripts/verify-guided-discovery-build.mjs",
    "build": "npm run verify:architecture && tsc --noEmit && vite build && node scripts/configure-workers-build-deploy.mjs && npm run verify:guided && npm run verify:finish && npm run verify:notverse && npm run check:social",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "check": "npm run verify:architecture && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "verify:finish": "node scripts/verify-finished-readverse.mjs",
    "verify:notverse": "node scripts/verify-notverse-build.mjs",
    "check:social": "tsc --noEmit -p social-worker/tsconfig.json"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.68.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
